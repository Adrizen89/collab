# ─────────────────────────────────────────────────────────────
# Variables d'environnement — copier en `.env` et adapter.
# Le fichier .env ne doit JAMAIS être commité (exigence sécurité).
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL (utilisé par docker-compose ET par Prisma) ---
POSTGRES_USER=collab
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=collab_docs

# URL de connexion Prisma. En local hors Docker : localhost:5432.
# Depuis un conteneur de l'app : remplacer localhost par "postgres".
DATABASE_URL="postgresql://collab:changeme_in_prod@localhost:5432/collab_docs?schema=public"

# --- Auth JWT ---
# Secrets longs et aléatoires. À régénérer en prod : `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Secret partagé Realtime → API (persistance interne des documents) ---
INTERNAL_API_SECRET=dev_internal_secret_change_me_please

# --- Serveur API ---
API_PORT=4000
# Origine autorisée pour CORS (front Vite)
WEB_ORIGIN=http://localhost:5173

# --- Serveur Realtime (WebSocket) ---
REALTIME_PORT=4001
# URL interne de l'API appelée par le serveur Realtime pour persister
API_INTERNAL_URL=http://localhost:4000

# --- Admin initial (seed) ---
SEED_ADMIN_EMAIL=admin@collab.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NAME=Administrateur

# --- Front (préfixe Vite obligatoire pour exposition au client) ---
VITE_API_URL=http://localhost:4000
VITE_REALTIME_URL=ws://localhost:4001
